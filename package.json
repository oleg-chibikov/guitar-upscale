{
  "name": "guitar-upscale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rimraf dist && next build",
    "start": "next start",
    "lint": "next lint",
    "deploy-surge": "surge --domain https://guitar-upscale.surge.sh dist/",
    "deploy-surge-org.uk": "surge --domain guitar-upscale.org.uk dist/",
    "deploy-surge-co.uk": "surge --domain guitar-upscale.co.uk dist/",
    "build-and-deploy-web-stage": "npm run build && npm run deploy-surge",
    "build-and-deploy-web-prod-1": "npm run build && npm run deploy-surge-org.uk",
    "build-and-deploy-web-prod-2": "npm run build && npm run deploy-surge-co.uk",
    "build-and-deploy-web-all": "npm run build && npm run deploy-surge-co.uk && npm run deploy-surge-org.uk && npm run deploy-surge"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.15",
    "@mui/material": "^5.15.15",
    "@reduxjs/toolkit": "^2.2.3",
    "@vercel/speed-insights": "^1.0.10",
    "midi-writer-js": "^3.1.1",
    "next": "14.2.1",
    "react": "^18",
    "react-dom": "^18",
    "react-ga4": "^2.1.0",
    "react-helmet-async": "^2.0.4",
    "react-redux": "^9.1.1",
    "redux-persist": "^6.0.0",
    "rxjs": "^7.8.1",
    "screenfull": "^6.0.2",
    "smplr": "^0.12.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.1",
    "postcss": "^8",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5"
  }
}
