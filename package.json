{
  "name": "guitar-upscale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "dev": "npm run open-browser && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "open-browser": "start http://localhost:3000",
    "deploy-surge": "surge --domain https://guitar-upscale.surge.sh dist/",
    "deploy-surge-org.uk": "surge --domain guitar-upscale.org.uk dist/",
    "deploy-surge-co.uk": "surge --domain guitar-upscale.co.uk dist/",
    "build-and-deploy-web-stage": "npm run build && npm run deploy-surge",
    "build-and-deploy-web-prod-1": "npm run build && npm run deploy-surge-org.uk",
    "build-and-deploy-web-prod-2": "npm run build && npm run deploy-surge-co.uk",
    "build-and-deploy-web-all": "npm run build && npm run deploy-surge-co.uk && npm run deploy-surge-org.uk && npm run deploy-surge",
    "update-all": "ncu --upgrade && pnpm i",
    "generate-chords": "ts-node --require ./tsconfig-paths-bootstrap.js src/utilities/generateChords.ts"
  },
  "dependencies": {
    "@datastructures-js/binary-search-tree": "^5.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@types/digital-goods-browser": "^2.0.3",
    "@types/next-auth": "^3.15.0",
    "@types/uuid": "^10.0.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "axios": "^1.20.0",
    "cookies-next": "^4.3.0",
    "dotenv": "^16.6.1",
    "googleapis": "^140.0.1",
    "http-errors": "^2.0.1",
    "midi-writer-js": "^3.2.1",
    "midifile-ts": "^1.5.2",
    "next": "14.2.4",
    "next-auth": "^4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga4": "^2.1.0",
    "react-helmet-async": "^2.0.5",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "rxjs": "^7.8.2",
    "screenfull": "^6.0.2",
    "server-only": "^0.0.1",
    "smplr": "^0.15.1",
    "uuid": "^10.0.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.15",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
