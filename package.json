{
  "name": "guitar-upscale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "dev": "npm run open-browser && next dev",
    "prebuild": "pnpm songs:index",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "open-browser": "start http://localhost:3000",
    "deploy-surge": "surge --domain https://guitar-upscale.surge.sh dist/",
    "deploy-surge-org.uk": "surge --domain guitar-upscale.org.uk dist/",
    "deploy-surge-co.uk": "surge --domain guitar-upscale.co.uk dist/",
    "build-and-deploy-web-stage": "npm run build && npm run deploy-surge",
    "build-and-deploy-web-prod-1": "npm run build && npm run deploy-surge-org.uk",
    "build-and-deploy-web-prod-2": "npm run build && npm run deploy-surge-co.uk",
    "build-and-deploy-web-all": "npm run build && npm run deploy-surge-co.uk && npm run deploy-surge-org.uk && npm run deploy-surge",
    "update-all": "ncu --upgrade && pnpm i",
    "songsterr": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/songsterr-example.mjs",
    "songs:index": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-song-index.mjs"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@datastructures-js/binary-search-tree": "^5.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@types/digital-goods-browser": "^2.0.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.20.0",
    "cookies-next": "^6.1.1",
    "date-fns": "^4.4.0",
    "googleapis": "^187.0.0",
    "http-errors": "^2.0.1",
    "idb": "^8.0.4",
    "konva": "^10.9.0",
    "midi-writer-js": "^3.2.1",
    "midifile-ts": "^1.5.2",
    "next": "16.4.2",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-ga4": "^3.0.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-konva": "^19.3.2",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "rxjs": "^7.8.2",
    "screenfull": "^6.0.2",
    "server-only": "^0.0.1",
    "smplr": "^1.1.0",
    "tonal": "^6.5.1",
    "uuid": "^14.0.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.13.1",
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
