{
  "name": "guitar-upscale",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "copy app.dev.json app.json && expo start --web",
    "build-web": "copy app.prod.json app.json && expo export -p web",
    "serve-build-web": "npm run build-web && serve dist --single",
    "deploy-surge": "surge --domain https://guitar-upscale.surge.sh dist/",
    "build-and-deploy-web": "npm run build-web && npm run deploy-surge"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "@react-native-assets/slider": "^7.1.1",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-picker/picker": "2.7.2",
    "@reduxjs/toolkit": "^2.2.3",
    "expo": "~50.0.14",
    "expo-status-bar": "~1.11.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-bouncy-checkbox": "^4.0.0",
    "react-native-gesture-handler": "^2.16.0",
    "react-native-orientation-locker": "^1.6.0",
    "react-native-reanimated": "^3.8.1",
    "react-native-web": "~0.19.10",
    "react-redux": "^9.1.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "rxjs": "^7.8.1",
    "smplr": "^0.12.3",
    "twrnc": "^4.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@expo/webpack-config": "^19.0.1",
    "@types/react": "~18.2.74",
    "typescript": "^5.4.4"
  },
  "private": true
}
